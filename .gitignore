# Editor and operating system noise
*.bak
*.tmp
*~
Thumbs.db
desktop.ini
.DS_Store

# Paradox map editor scratch output
map_data/*.backup

# Heap dumps and other large diagnostic files
*.hprof

# Raw source art kept outside the repository
/_source/

# Map binaries too large for git without LFS. Rebuild them with tools/map.
map_data/heightmap.png
map_data/packed_heightmap.png
map_data/indirection_heightmap.png
.impeccable/

# Terrain textures regenerated by tools/map/build_terrain.py, too large for git.
gfx/map/terrain/detail_index.tga
gfx/map/terrain/detail_intensity.tga
gfx/map/terrain/colormap.dds
gfx/map/terrain/flat_maps/flatmap.dds
gfx/map/terrain/flat_maps/flatmap_tgp.dds
tools/map/build/preview_*.png

# Local authoring tool kept off the repository
tools/map/assign_tool.html

# Blank material masks sized to the map, regenerated by tools/map/build_masks.py
gfx/map/terrain/masks/
gfx/map/terrain/masks_gen/
map_data/nodes.dat

# Python bytecode
__pycache__/

# Tree positions regenerated by tools/map/build_trees.py, sixty megabytes of text
gfx/map/map_object_data/generated/
