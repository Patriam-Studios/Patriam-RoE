############################################################
# Thenithrian armies. The Roman legionary of Imperator: Rome.
#
# Ported from Imperator: Rome, which Paradox gave written permission to use.
# The mesh, the helmet, the weapon and the shield are Imperator's own, and so are
# the animations, which both ported cultures share out of
# gfx/models/units/imperator/animations.
#
# The twenty four state names below are the ones Crusader Kings III asks an army
# entity for. Imperator names its states differently, so each one here carries
# whichever Imperator animation reads closest.
#
# SCALE: Imperator draws this soldier at 0.1 and Crusader Kings III draws its own
# at 0.06. The two games measure their worlds differently, so 0.1 is a starting
# value and not a measured one. If the soldiers stand too tall or too short beside
# a holding, this is the only number to turn, and every attachment below has to be
# turned with it.
############################################################

pdxmesh = {
	name = "patriam_roman_infantry_01_mesh"
	file = "roman_legion_heavy_infantry_01.mesh"
	# Crusader Kings III draws its own soldiers at 0.06, and both games declare no
	# scale at all on their buildings, so the two measure their worlds alike and a
	# soldier of Imperator belongs at the same 0.06. Turn this and every attachment
	# below together, since an attachment does not inherit the body's scale.
	scale = 0.06
	cull_distance = 3000

	lod_percentages = {
		lod = { index = 1 percent = 10.0 }
		lod = { index = 2 percent = 5.0 }
	}

	animation = { id = "idle_base_animation" type = "../animations/ROM_infantry_01_idle_2_base_shield_L.anim" }
	animation = { id = "idle_var_1_animation" type = "../animations/ROM_infantry_01_idle_2_var_1_shield_L.anim" }
	animation = { id = "moving_animation" type = "../animations/ROM_infantry_01_moving_2.anim" }
	animation = { id = "force_march_animation" type = "../animations/ROM_infantry_01_force_march_2.anim" }
	animation = { id = "retreat_animation" type = "../animations/ROM_infantry_01_retreat_2.anim" }
	animation = { id = "army_drill_animation" type = "../animations/ROM_infantry_01_army_drill_2.anim" }
	animation = { id = "recruiting_action_animation" type = "../animations/ROM_infantry_01_recruiting_action.anim" }
	animation = { id = "recruiting_loop_animation" type = "../animations/ROM_infantry_01_recruiting_loop.anim" }
	animation = { id = "build_road_shoveling_animation" type = "../animations/ROM_infantry_01_build_road_shoveling.anim" }
	animation = { id = "offensive_successful_animation" type = "../animations/ROM_infantry_01_weapon_2_offensive_successful.anim" }
	animation = { id = "even_offensive_seq_1_animation" type = "../animations/ROM_infantry_01_weapon_2_offensive_sequence_1.anim" }
	animation = { id = "winlose_offensive_seq_1_animation" type = "../animations/ROM_infantry_01_weapon_2_offensive_sequence_2.anim" }
	animation = { id = "pursuit_offensive_seq_1_animation" type = "../animations/ROM_infantry_01_weapon_2_offensive_sequence_3.anim" }
	animation = { id = "even_defensive_seq_1_animation" type = "../animations/ROM_infantry_01_weapon_2_defensive_sequence_1.anim" }
	animation = { id = "winlose_defensive_seq_1_animation" type = "../animations/ROM_infantry_01_weapon_2_defensive_sequence_2.anim" }
	animation = { id = "pursuit_defensive_seq_1_animation" type = "../animations/ROM_infantry_01_weapon_2_defensive_sequence_3.anim" }
	animation = { id = "even_winlose_tx_offensive_1_animation" type = "../animations/ROM_infantry_01_weapon_2_offensive_counter.anim" }
	animation = { id = "winlose_even_tx_offensive_1_animation" type = "../animations/ROM_infantry_01_weapon_2_offensive_block.anim" }
	animation = { id = "even_winlose_tx_defensive_1_animation" type = "../animations/ROM_infantry_01_weapon_2_defensive_counter.anim" }
	animation = { id = "winlose_even_tx_defensive_1_animation" type = "../animations/ROM_infantry_01_weapon_2_defensive_block.anim" }

	meshsettings = {
		name = "roman_legion_heavy_infantry_01_LOD0Shape"
		index = 0
		texture_diffuse = "base_infantry_01_diffuse.dds"
		texture_normal = "base_infantry_01_normal.dds"
		texture_specular = "base_infantry_01_properties.dds"
		shader = "standard"
		shader_file = "gfx/FX/pdxmesh.shader"
		additional_shader_defines = {
			"MAP_LIGHTING_HACK"
		}
	}

	meshsettings = {
		name = "roman_legion_heavy_infantry_01_LOD0Shape"
		index = 1
		texture_diffuse = "roman_heavy_infantry_01_diffuse.dds"
