entity = {
	name = "patriam_roman_infantry_01_entity"
	pdxmesh = "patriam_roman_infantry_01_mesh"

	default_state = "idle"

	state = {
		name = "idle"
		animation = "idle_base_animation"
		looping = no
		next_state = idle
		chance = 4
		start_event = { node = THE_RIG:Right_hand_node_1 entity = "patriam_roman_sword_01_entity" }
		start_event = { node = THE_RIG:world_node_1 entity = "patriam_roman_shield_01_entity" }
		event = { time = 0.0 soundparameter = {"tier_unit_armourlayer_fullplate" = 0.0 } soundparameter = {"props_wood_metal" = 0.0 } sound = { soundeffect = "event:/SFX/Animations/Units/Infantry/sfx_anim_unit_infantry_idle_base" }}
	}

	state = {
		name = "idle"
		animation = "idle_var_1_animation"
		looping = no
		next_state = idle
		chance = 1
		start_event = { node = THE_RIG:Right_hand_node_1 entity = "patriam_roman_sword_01_entity" }
		start_event = { node = THE_RIG:world_node_1 entity = "patriam_roman_shield_01_entity" }
