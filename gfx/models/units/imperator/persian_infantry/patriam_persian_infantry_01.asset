############################################################
# Akarian armies. The Persian spearman of Imperator: Rome.
#
# Ported from Imperator: Rome, which Paradox gave written permission to use.
# The mesh, the helmet, the spear and the shield are Imperator's own, and so are
# the animations, which all three ported cultures share out of
# gfx/models/units/imperator/animations.
#
# WHICH WEAPON SET. Imperator sorts its infantry animations into two, set one for
# the spear and set two for the sword, and a soldier playing the wrong set swings
# a weapon he is not holding. Imperator's own persian_gfx_light_infantry, which
# is the soldier ported here, plays set one in every one of its combat states and
# carries persian_spear_01 in its right hand, so set one is what is named below.
# That is the same set the Greek hoplite takes, which is why the two share their
# states word for word. Imperator's persian_gfx_heavy_infantry plays set two and
# is not ported.
#
# TWO SOLDIERS, THREE QUALITY TIERS. Crusader Kings III asks a graphical culture
# for a model at each of the quality tiers 0, 2 and 4. Imperator ships two
# Persian spearmen, a levy in a quilted coat and a soldier in scale armour, so
# the levy stands at tier 0 and the armoured soldier at the two above it, which
# is wired in gfx/models/units/entity_links/00_army_entity_links.txt.
#
# The twenty four state names below are the ones Crusader Kings III asks an army
# entity for. Imperator names its states differently, so each one here carries
# whichever Imperator animation reads closest. Two have no counterpart at all:
# Imperator has no sick soldier, so a sick one idles and marches as a well one
# does and is told apart only by the flies vanilla puts over his head, and it has
# no soldier going home either, so disbanding borrows the recruiting animation.
#
# SCALE: Imperator draws this soldier at 0.1 and Crusader Kings III draws its own
# at 0.06. Every mesh and every attachment below carries 0.06, and an attachment
# does not inherit the body's scale, so all of them have to be turned together.
############################################################

############################################################
# The armoured spearman, worn at the quality tiers 2 and 4.
############################################################

pdxmesh = {
	name = "patriam_persian_infantry_01_mesh"
	file = "persian_infantry_01.mesh"
	scale = 0.06
	cull_distance = 3000

